# ── Frontend (Vite) ─────────────────────────────────────────────
# Leave BOTH empty to run in Demo Mode (100% in-browser, localStorage, no keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Seed script (scripts/seed.ts) ───────────────────────────────
# Uses the same URL + anon key to call the `capture` edge function.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Edge function secrets (set with `supabase secrets set ...`) ─
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# EMBEDDING_PROVIDER=supabase   # or "openai"
# OPENAI_API_KEY=sk-...         # only if EMBEDDING_PROVIDER=openai
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
